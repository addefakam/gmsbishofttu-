generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  POLICE
  SUPERUSER
  OPERATOR
  STAFF
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  SUITE
  DELUXE
  KING
  STANDARD
  STANDARD_SUITE
  JUNIOR_SUITE
  EXECUTIVE_SUITE
  PRESIDENTIAL_SUITE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum PaymentStatusType {
  PAID
  PARTIAL
  PENDING
}

enum PaymentMethodType {
  CASH
  TRANSFER
  CARD
  MOBILE
}

enum ReservationStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
  DELETED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum HousekeepingTaskType {
  CLEANING
  MAINTENANCE
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SuspectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GroupBookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Provider {
  id          String          @id @default(cuid())
  name        String
  ownerName   String
  phone       String
  email       String          @default("")
  address     String          @default("")
  type        String          @default("GUEST_HOUSE")
  // License No is the legal business identifier issued by the government.
  // Required + unique — no two guesthouses can share the same license.
  // The DB-level @unique provides defense-in-depth against race conditions
  // on top of the API-level check in /api/providers POST.
  licenseNo   String          @unique
  licenseFile String          @default("")
  status      ProviderStatus  @default(PENDING)
  latitude    Float           @default(9.02)
  longitude   Float           @default(38.75)
  approvedBy  String?
  approvedAt  DateTime?
  rejectionReason String      @default("")
  suspensionReason String     @default("")
  suspendedAt  DateTime?
  suspendedBy  String          @default("")
  // Certificate of Registration — issued by system admin
  certNumber    String?         // e.g. "GHMS-CERT-2026-0007" (null until first issued)
  certIssuedAt  DateTime?
  certIssuedBy  String?         // userId of the admin who issued
  certIssuedByName String?      // admin's display name (denormalized for the cert)
  // Manually-set bed count for subscription billing. Set by the system
  // admin on the Provider management page. If null, the system falls
  // back to auto-calculating from room types (DOUBLE=2 beds, all others=1).
  bedCount      Int?
  // ── Structured location for jurisdiction-based filtering ──
  // These are extracted from the address string during registration
  // and used by police API routes to filter by sub-city/woreda.
  subCity     String  @default("")
  woreda      String  @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  users       User[]
  rooms       Room[]
  guests      Guest[]
  reservations Reservation[]
  expenses    Expense[]
  daytimeServices  DaytimeService[]
  daytimeBookings DaytimeBooking[]
  daytimeRoomBookings DaytimeRoomBooking[]
  resources   Resource[]
  housekeepingTasks HousekeepingTask[]
  settings    Settings[]
  notifications Notification[]
  subscription Subscription?
  groupBookings    GroupBooking[]
  staffLogs        StaffLog[]
  messageTemplates MessageTemplate[]
  messageLogs      MessageLog[]
  tasks            Task[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id          String          @id @default(cuid())
  username    String          @unique
  password    String
  role        UserRole        @default(STAFF)
  name        String
  email       String?         @default("")
  phone       String?         @default("")
  permissions String          @default("[\"reservations\",\"guests\"]")  // JSON array of allowed pages for STAFF
  policeRank  String          @default("")  // ADMIN, DETECTIVE, OFFICER, VIEWER for POLICE role
  isActive    Boolean         @default(true)
  lastLogin   DateTime?
  providerId  String?
  createdBy    String?         // User ID of the OPERATOR who created this account
  // ── Police jurisdiction (for POLICE role only) ──
  // CITY = full city access (existing behavior)
  // SUBCITY = filtered to one sub-city
  // WOREDA = filtered to one woreda
  jurisdictionType String  @default("CITY")
  subCity     String?         // e.g. "Debaayyuu" — set when jurisdictionType = SUBCITY or WOREDA
  woreda      String?         // e.g. "Dirree" — set only when jurisdictionType = WOREDA
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  provider    Provider?       @relation(fields: [providerId], references: [id])

  // Tasks — three relations so we can filter "tasks assigned to me",
  // "tasks I assigned to others", and "tasks I completed".
  assignedTasks   Task[]        @relation("AssignedTasks")
  assignedByTasks Task[]        @relation("AssignedByTasks")
  completedTasks  Task[]        @relation("CompletedTasks")

  @@index([providerId])
  @@index([isActive])
  @@index([createdBy])
  @@index([jurisdictionType])
  @@index([subCity])
  @@index([woreda])
}

model Room {
  id            String     @id @default(cuid())
  number        String
  name          String
  type          RoomType
  pricePerNight Float
  // Optional weekend rate — if set, applies to Friday + Saturday nights
  // (Ethiopian weekend). If null or 0, falls back to pricePerNight for
  // every night. Sunday is NOT charged the weekend rate by default —
  // most Bishoftu guesthouses treat Fri+Sat as the premium nights.
  pricePerNightWeekend Float?
  floor         Int
  capacity      Int
  status        RoomStatus @default(AVAILABLE)
  amenities     String
  description   String
  image         String?
  providerId    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  provider           Provider       @relation(fields: [providerId], references: [id])
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  daytimeRoomBookings DaytimeRoomBooking[]

  @@unique([number, providerId])
  @@index([providerId])
  @@index([status])
}

model Guest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String   @default("")
  idNumber    String   @default("")
  idType      String   @default("")
  nationality String   @default("")
  region      String   @default("")
  zone        String   @default("")
  woreda      String   @default("")
  kebele      String   @default("")
  houseNumber String   @default("")
  streetName  String   @default("")
  plateNumber String   @default("")
  weapon      String   @default("")
  address     String   @default("")
  notes       String   @default("")
  vip         Boolean  @default(false)
  totalSpent  Float    @default(0)
  totalStays  Int      @default(0)
  providerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider     Provider  @relation(fields: [providerId], references: [id])
  reservations Reservation[]
  reviews      Review[]

  @@index([providerId])
  @@index([phone])
  @@index([idNumber])
  @@index([email])
  @@index([createdAt])
  @@index([name])
  @@index([region])
  @@index([zone])
  @@index([woreda])
}

model Reservation {
  id              String            @id @default(cuid())
  guestId         String
  roomId          String
  checkIn         String
  checkOut        String
  nights          Int
  roomRate        Float
  totalCost       Float
  paidAmount      Float             @default(0)
  balance         Float             @default(0)
  paymentStatus   PaymentStatusType @default(PENDING)
  paymentMethod   PaymentMethodType?
  status          ReservationStatus @default(UPCOMING)
  notes           String            @default("")
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  taxAmount       Float             @default(0)
  discountAmount  Float             @default(0)
  // Second guest for DOUBLE/TWIN rooms
  secondGuestName    String           @default("")
  secondGuestPhone   String           @default("")
  secondGuestIdNumber String          @default("")
  // Exceptional reservation (one guest in double room)
  exceptionallyReserved Boolean        @default(false)
  exceptionReason     String           @default("")
  providerId      String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id])
  guest    Guest    @relation(fields: [guestId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  groupBooking GroupBooking? @relation(fields: [groupBookingId], references: [id])
  payments Payment[]
  reviews  Review[]

  groupBookingId String?

  @@index([providerId])
  @@index([guestId])
  @@index([roomId])
  @@index([status])
  @@index([createdAt])
  @@index([checkIn])
  @@index([groupBookingId])
}

model DaytimeService {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String
  duration    String   @default("")
  description String   @default("")
  active      Boolean  @default(true)
  providerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider        Provider        @relation(fields: [providerId], references: [id])
  daytimeBookings DaytimeBooking[]

  @@index([providerId])
}

model DaytimeBooking {
  id             String            @id @default(cuid())
  serviceId      String
  guestName      String
  guestPhone     String
  date           String
  time           String
  quantity       Int               @default(1)
  unitPrice      Float
  totalCost      Float
  paidAmount     Float             @default(0)
  paymentStatus  PaymentStatusType @default(PENDING)
  paymentMethod  PaymentMethodType?
  notes          String            @default("")
  providerId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  provider Provider        @relation(fields: [providerId], references: [id])
  service  DaytimeService  @relation(fields: [serviceId], references: [id])
  payments Payment[]

  @@index([providerId])
  @@index([serviceId])
  @@index([guestPhone])
  @@index([date])
  @@index([createdAt])
}

// ── Daytime Room Booking — time-based room reservation (max 12 hours) ──
// Separate from overnight Reservation: no check-in/check-out lifecycle,
// no bed-night accounting. Used for day-use rooms (meetings, rest,
// short stays). Hourly rate, max 12 hours per booking.
model DaytimeRoomBooking {
  id             String            @id @default(cuid())
  roomId         String
  guestName      String
  guestPhone     String            @default("")
  date           String            // YYYY-MM-DD
  startTime      String            // HH:mm (e.g. "09:00")
  endTime        String            // HH:mm (e.g. "15:00")
  totalHours     Float             // computed (max 12, enforced server-side)
  roomRate       Float             // hourly rate (ETB/hour)
  totalCost      Float             // totalHours * roomRate
  paidAmount     Float             @default(0)
  paymentStatus  PaymentStatusType @default(PENDING)
  paymentMethod  PaymentMethodType?
  notes          String            @default("")
  status         ReservationStatus @default(UPCOMING)
  providerId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  provider Provider   @relation(fields: [providerId], references: [id])
  room     Room      @relation(fields: [roomId], references: [id])
  payments Payment[]

  @@index([providerId])
  @@index([roomId])
  @@index([guestPhone])
  @@index([date])
  @@index([status])
  @@index([createdAt])
}

model Expense {
  id            String            @id @default(cuid())
  date          String
  category      String
  description   String
  amount        Float
  vendor        String            @default("")
  paymentMethod PaymentMethodType
  receiptNo     String            @default("")
  taxAmount     Float             @default(0)
  providerId    String
  // Optional link to the StockMovement that triggered this expense
  // (null = manually-created expense; set = auto-created from a restock)
  stockMovementId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([date])
  @@index([category])
  @@index([stockMovementId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  nameAm    String
  color     String
  icon      String
  createdAt DateTime @default(now())
}

model Resource {
  id           String   @id @default(cuid())
  name         String
  category     String
  quantity     Float
  unit         String
  minLevel     Float   @default(0)
  costPerUnit  Float   @default(0)
  supplier     String  @default("")
  lastRestocked DateTime?
  providerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
  movements StockMovement[]

  @@index([providerId])
  @@index([category])
}

// Audit log of every quantity change to a Resource — restocks, manual
// edits, deductions (housekeeping consumption, future), corrections.
// One row per change. Positive delta = stock added; negative = removed.
model StockMovement {
  id          String   @id @default(cuid())
  resourceId  String
  delta       Float    // signed: +N for restock, -N for consumption/adjustment
  reason      String   @default("")  // "restock", "edit", "consumption", "stocktake-correction", "delete"
  previousQty Float    // quantity before this movement
  newQty      Float    // quantity after this movement
  userId      String   @default("")  // who performed the change
  userName    String   @default("")
  providerId  String
  createdAt   DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([providerId])
  @@index([createdAt])
}

model Payment {
  id               String            @id @default(cuid())
  reservationId    String?
  daytimeBookingId String?
  daytimeRoomBookingId String?
  amount           Float
  method           PaymentMethodType
  referenceNo      String            @default("")
  notes            String            @default("")
  providerId       String
  createdAt        DateTime          @default(now())

  reservation    Reservation?    @relation(fields: [reservationId], references: [id])
  daytimeBooking DaytimeBooking? @relation(fields: [daytimeBookingId], references: [id])
  daytimeRoomBooking DaytimeRoomBooking? @relation(fields: [daytimeRoomBookingId], references: [id])

  @@index([providerId])
  @@index([reservationId])
  @@index([daytimeBookingId])
  @@index([daytimeRoomBookingId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  providerId String?
  userId    String?
  createdAt DateTime         @default(now())

  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model HousekeepingTask {
  id            String                 @id @default(cuid())
  roomId        String
  type          HousekeepingTaskType
  status        HousekeepingTaskStatus @default(PENDING)
  assignedTo    String?
  scheduledDate String
  notes         String                 @default("")
  completedAt   DateTime?
  providerId    String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([providerId])
  @@index([roomId])
  @@index([status])
  @@index([scheduledDate])
}

model Review {
  id            String   @id @default(cuid())
  guestId       String
  reservationId String
  rating        Int
  comment       String   @default("")
  createdAt     DateTime @default(now())

  guest       Guest       @relation(fields: [guestId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([guestId])
  @@index([reservationId])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  message    String
  type       String   @default("INFO")
  providerId String?
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([createdAt])
}

model Settings {
  id              String   @id @default(cuid())
  guestHouseName  String   @default("Guest House")
  ownerName       String   @default("")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  currency        String   @default("ETB")
  taxRate         Float    @default(0)
  language        String   @default("en")
  logo            String?
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("12:00")
  configJson      Json?
  providerId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

// ─── Group Bookings ──────────────────────────────────────────────────────────

model GroupBooking {
  id           String             @id @default(cuid())
  name         String
  contactName  String             @default("")
  contactPhone String             @default("")
  contactEmail String             @default("")
  startDate    String
  endDate      String
  notes        String             @default("")
  status       GroupBookingStatus @default(PENDING)
  totalRooms   Int                @default(0)
  totalGuests  Int                @default(0)
  totalCost    Float              @default(0)
  // ── Group discount ──
  // discountType: "AMOUNT" (fixed ETB) or "PERCENT" (% of subtotal)
  // discountAmount: the value — when AMOUNT, it's ETB; when PERCENT, it's 0-100
  // The group's effective grand total = subtotal - discount
  discountType    String             @default("AMOUNT")
  discountAmount  Float              @default(0)
  providerId   String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  provider     Provider      @relation(fields: [providerId], references: [id])
  reservations Reservation[]

  @@index([providerId])
  @@index([status])
  @@index([startDate])
}

// ─── Staff Activity Log ──────────────────────────────────────────────────────

model StaffLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String   @default("")
  action     String   // CHECKIN, CHECKOUT, CREATE_RESERVATION, UPDATE_RESERVATION, CANCEL_RESERVATION, CREATE_PAYMENT, CREATE_EXPENSE, UPDATE_ROOM, etc.
  targetType String   @default("") // RESERVATION, GUEST, ROOM, PAYMENT, EXPENSE, GROUP_BOOKING, etc.
  targetId   String   @default("")
  details    String   @default("") // JSON with change details
  ipAddress  String   @default("")
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

// ─── Tasks — formal staff work assignments with audit trail ──────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String       @default("")
  status          TaskStatus   @default(PENDING)
  priority        TaskPriority @default(MEDIUM)
  // Category — free-text label so operators can group tasks: "Cleaning",
  // "Front Desk", "Maintenance", "Inventory", etc.
  category        String       @default("General")
  // Due date as ISO string (YYYY-MM-DD) — kept as text to match the
  // existing convention used by Reservation.checkIn/checkOut.
  dueDate         String       @default("")
  // Assignment & audit — full relations to User so we can filter
  // "tasks assigned to Abebe" and "tasks completed by Abebe".
  assignedToUserId String?
  assignedToUser   User?        @relation("AssignedTasks", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedByUserId String?
  assignedByUser   User?        @relation("AssignedByTasks", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  completedByUserId String?
  completedByUser  User?        @relation("CompletedTasks", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  // Provider scoping — same pattern as Room, Reservation, StaffLog.
  providerId       String
  provider         Provider     @relation(fields: [providerId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([providerId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([providerId, status])
  @@index([providerId, assignedToUserId, status])
}

// ─── Guest Communication ─────────────────────────────────────────────────────

model MessageTemplate {
  id         String         @id @default(cuid())
  name       String         // "Check-in Reminder", "Welcome Message"
  type       String         // CHECKIN_REMINDER, WELCOME, CHECKOUT_REMINDER, CUSTOM
  channel    MessageChannel @default(SMS)
  subject    String         @default("")
  body       String         // Template body with placeholders: {{guestName}}, {{roomNumber}}, etc.
  isDefault  Boolean        @default(false)
  isActive   Boolean        @default(true)
  providerId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
  logs     MessageLog[]

  @@index([providerId])
  @@index([type])
}

model MessageLog {
  id            String        @id @default(cuid())
  templateId    String?
  recipient     String        // Phone number
  channel       MessageChannel @default(SMS)
  message       String        // Final rendered message
  status        MessageStatus @default(PENDING)
  errorMessage  String        @default("")
  reservationId String?
  guestId       String?
  providerId    String
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  provider Provider        @relation(fields: [providerId], references: [id])
  template MessageTemplate? @relation(fields: [templateId], references: [id])

  @@index([providerId])
  @@index([recipient])
  @@index([status])
  @@index([createdAt])
}

// ─── Suspected Persons (Police-only) ─────────────────────────────────────────

model SuspectedPerson {
  id            String           @id @default(cuid())
  name          String
  phone         String           @default("")
  idNumber      String           @default("")
  idType        String           @default("")
  nationality   String           @default("")
  address       String           @default("")
  description   String           @default("")
  severity      SuspectSeverity  @default(MEDIUM)
  is_active     Boolean          @default(true)
  registeredBy  String           @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  matches       SuspectMatch[]

  @@index([name])
  @@index([phone])
  @@index([idNumber])
  @@index([severity])
  @@index([is_active])
}

model SuspectMatch {
  id              String           @id @default(cuid())
  suspectedPersonId String
  matchType       String           // "RESERVATION", "DAYTIME_BOOKING", "GUEST_CHECKIN"
  guestName       String
  guestPhone      String           @default("")
  guestIdNumber   String           @default("")
  providerName    String           @default("")
  providerId      String           @default("")
  reservationId   String?
  daytimeBookingId String?
  details         String           @default("")  // Full JSON details about the booking
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  suspectedPerson SuspectedPerson @relation(fields: [suspectedPersonId], references: [id])

  @@index([suspectedPersonId])
  @@index([isRead])
  @@index([createdAt])
  @@index([guestPhone])
  @@index([guestIdNumber])
  @@index([providerId])
}

// ─── Police Intelligence & Security ─────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  officerName String   @default("")
  action      String   // VIEW_GUEST, VIEW_MATCH, EXPORT_DATA, LOGIN, etc.
  targetId    String?
  targetType  String?  @default("")
  details     String?
  ipAddress   String?  @default("")
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([officerName])
}

model Geofence {
  id          String   @id @default(cuid())
  name        String
  address     String   @default("")
  latitude    Float    @default(0)
  longitude   Float    @default(0)
  radius      Float    @default(1000) // meters
  severity    String   @default("HIGH")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([severity])
}

model FrequentStayAlert {
  id             String   @id @default(cuid())
  guestName      String
  guestPhone     String   @default("")
  guestIdNumber  String   @default("")
  providerNames  String   @default("[]") // JSON array of provider names
  stayCount      Int      @default(0)
  avgDaysBetween Float    @default(0)
  riskLevel      String   @default("MEDIUM")
  isReviewed     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([isReviewed])
  @@index([riskLevel])
  @@index([guestPhone])
  @@index([guestIdNumber])
}

// ─── Subscription ──────────────────────────────────────────────────────────

enum SubscriptionCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

model SubscriptionPlan {
  id          String              @id @default(cuid())
  name        String
  cycle       SubscriptionCycle
  price       Float
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  subscriptions Subscription[]

  @@index([cycle])
  @@index([isActive])
}

model Subscription {
  id            String              @id @default(cuid())
  providerId    String              @unique
  startDate     DateTime
  endDate       DateTime
  cycle         SubscriptionCycle  @default(MONTHLY)
  price         Float               @default(0)
  planId        String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  provider      Provider            @relation(fields: [providerId], references: [id])
  plan          SubscriptionPlan?   @relation(fields: [planId], references: [id])
  payments      SubscriptionPayment[]

  @@index([endDate])
  @@index([planId])
}

model SubscriptionPayment {
  id              String              @id @default(cuid())
  subscriptionId String
  amount          Float
  cycle           SubscriptionCycle
  periodStart     DateTime
  periodEnd       DateTime
  markedBy        String              // userId of SUPERUSER who marked
  notes           String              @default("")
  createdAt       DateTime            @default(now())

  subscription    Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([createdAt])
}

model PoliceAlertConfig {
  id                       String   @id @default(cuid())
  emailEnabled             Boolean  @default(false)
  emailRecipients          String   @default("[]") // JSON array of email addresses
  smsEnabled               Boolean  @default(false)
  smsRecipients            String   @default("[]") // JSON array of phone numbers
  escalationDelayMins      Int      @default(60) // minutes before escalating HIGH severity
  criticalImmediate        Boolean  @default(true) // CRITICAL alerts are immediate
  anomalyDetectionEnabled  Boolean  @default(false) // Smart Anomaly Detection ON/OFF toggle
  disabledOperatorPages     String   @default("[]") // JSON array of page keys hidden from OPERATOR/STAFF sidebar
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Password reset tokens — created when user requests reset, consumed on use.
// Single-use, expire after 1 hour. Used by /api/auth/reset-request and
// /api/auth/reset-confirm.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   // FK to User.id (not enforced at DB level to keep
                    // migration simple — we add an index instead)
  token     String   @unique // the random token in the reset link
  expiresAt DateTime // now + 1 hour
  usedAt    DateTime? // null until consumed
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}